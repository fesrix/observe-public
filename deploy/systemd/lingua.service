[Unit]
Description=Lingua School web application
After=network.target postgresql.service

[Service]
Type=simple
User=lingua
Group=lingua
WorkingDirectory=/srv/lingua/current
EnvironmentFile=/etc/lingua/runtime.env
Environment=NODE_ENV=production
Environment=TZ=Asia/Tehran
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lingua
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
