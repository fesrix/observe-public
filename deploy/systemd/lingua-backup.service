[Unit]
Description=Back up Lingua School database
After=postgresql.service
[Service]
Type=oneshot
User=postgres
Group=postgres
Environment=TZ=Asia/Tehran
ExecStart=/usr/local/sbin/lingua-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/lingua
