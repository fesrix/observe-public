{
  "name": "lingua-school",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --test tests/db/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "tsx scripts/local-db.ts",
    "db:test:prepare": "tsx scripts/prepare-test-db.ts",
    "admin": "tsx scripts/admin.ts",
    "seed": "tsx scripts/seed.ts",
    "format": "prettier --write src scripts tests *.ts *.json"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "dotenv": "18.0.10",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "embedded-postgres": "16.15.0-beta.19",
    "prettier": "3.6.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
